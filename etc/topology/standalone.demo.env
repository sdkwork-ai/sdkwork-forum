# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_forum_demo`
# and a dedicated Redis logical DB index so that no cache key ever collides with another
# shared-redis environment.
SDKWORK_FORUM_DEPLOYMENT_PROFILE=standalone
SDKWORK_FORUM_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_FORUM_PROFILE_ID=standalone.demo
SDKWORK_FORUM_APPLICATION_PUBLIC_HTTP_URL=https://forum-demo.sdkwork.com
SDKWORK_FORUM_WEB_DEV_INGRESS_BIND=127.0.0.1:4933
SDKWORK_FORUM_PC_INTERNAL_DEV_PORT=4935
SDKWORK_FORUM_H5_INTERNAL_DEV_PORT=4936

# Isolation: dedicated Redis logical DB index on the shared Redis so hardcoded service prefixes
# never collide with dev/test/staging/prod. The dedicated database schema/user `sdkwork_forum_demo`
# keeps relational data independent from every other environment.
SDKWORK_FORUM_REDIS_URL=redis://127.0.0.1:6379/9
SDKWORK_FORUM_REDIS_ENABLED=true
SDKWORK_FORUM_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
VITE_SDKWORK_FORUM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080
